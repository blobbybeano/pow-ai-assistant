# Copy this file to .env and enter credentials for your own accounts.
# Never commit .env or any real credentials.

# AI provider
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional PostgreSQL persistence
DATABASE_URL=

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
TWILIO_WHATSAPP_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# Google OAuth and Maps
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PROJECT_ID=
GOOGLE_MAPS_API_KEY=

# Checkatrade scraper
CHECKATRADE_SCRAPER_INTERNAL_URL=http://localhost:8080
CHECKATRADE_SCRAPER_PUBLIC_URL=
CHECKATRADE_WEBHOOK_TOKEN=
POWWASH_WEBHOOK_URL=http://localhost:5000/webhook/checkatrade
CHECKATRADE_LONDON_MEMBER_ID=
CHECKATRADE_MIDLANDS_MEMBER_ID=

# Flask
SECRET_KEY=
FLASK_ENV=production

# Scraper server
PORT=8080
LOG_LEVEL=info
